#!/bin/sh
#
# The DYT gimbal uses TEL2 (/dev/ttyS3). SDM50 ranging and closing-speed
# estimation use GPS1 (/dev/ttyS0), so the two drivers use separate ports.
#

dyt_gimbal start -d /dev/ttyS3
dyt_guidance start

# GPS is connected through CAN. GPS1 maps to /dev/ttyS0 and is used by the
# forward-facing SDM50 for net-capture distance triggering.
sdm50 start -d /dev/ttyS0 -R 0

comm_emergency start
gnss_emergency start

if param compare MAV_SYS_ID 1
then
	cooperative_rendezvous start -r broadcast
else
	cooperative_rendezvous start -r rendezvous -t 1
fi
