#!/bin/sh
#
# The DYT gimbal and integrated SDM50 use TEL2 (/dev/ttyS3).
# The gimbal automatically reports laser status (55 AA 0C 03) at 200 Hz.
# dyt_gimbal publishes range and closing speed without laser-start commands.
#

dyt_gimbal start -d /dev/ttyS3
dyt_guidance start

comm_emergency start
gnss_emergency start

if param compare MAV_SYS_ID 1
then
	cooperative_rendezvous start -r broadcast
else
	cooperative_rendezvous start -r rendezvous -t 1
fi
